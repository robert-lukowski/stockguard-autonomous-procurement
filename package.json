{
  "name": "stockguard-autonomous-procurement",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "validate:aws-bootstrap": "node scripts/validate-aws-readonly-bootstrap.mjs",
    "test:aws-inventory": "node scripts/test-aws-readonly-inventory.mjs",
    "build:lambda": "esbuild infrastructure/terraform/lambda/supplierSimulatorHandler.ts --bundle --platform=node --target=node22 --format=cjs --outfile=infrastructure/terraform/build/supplierSimulator/index.js && esbuild infrastructure/terraform/lambda/liveCallerHandler.ts --bundle --platform=node --target=node22 --format=cjs --external:@aws-sdk/client-secrets-manager --outfile=infrastructure/terraform/build/liveCaller/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1117.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "motion": "^13.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
